  "narrative": {
    "northStar": "The Quiet Console",
    "overview": "VozVarejo is the category-standard SaaS voice studio executed with care: a cool, near-white workspace where the path offers → script → voice & MP3 is always the most obvious thing on screen. The interface steps back so the shopkeeper's content (store name, products, prices, the script, the chosen voice) carries the screen. Hierarchy comes from ink weight, one accent hue, and 1px structure, never from colored panels competing for attention.\n\nDensity is moderate and touch-safe: controls are 36–48px tall, cards breathe at 20–24px padding, and every long action reports progress in place or through a floating toast. Light and dark themes are first-class siblings driven by the same token names; dark swaps the ground to near-black and lifts the violet to a lavender that reads on dark surfaces.\n\nThe system explicitly refuses the generic dashboard of stacked orange cards and buttons that compete with each other: one dark primary action per decision point, violet only where the user's attention or the AI is involved.",
    "keyCharacteristics": [
      "Cool near-white ground, white surfaces, 1px borders as the main structural device.",
      "Near-black ink for the primary action; violet as the single accent (active step, selection, AI actions, progress).",
      "Green, amber, red are state colors only, always paired with a soft tinted ground.",
      "Geist throughout, semibold for hierarchy, tabular numerals for prices, counts and times.",
      "8/10/12px radii by size; soft shadows only on floating layers."
    ],
    "rules": [
      {
        "name": "The One Violet Rule",
        "body": "Violet marks exactly three things: where the user is (active step, selection), what the AI does (AI-action buttons, generation progress), and focus. It is never decoration, never a section background, never a second brand color.",
        "section": "colors"
      },
      {
        "name": "The State-Only Rule",
        "body": "Green, amber and red appear only to report a state, always as a strong hue on its own soft tint. No product, template or category is ever color-coded with them.",
        "section": "colors"
      },
      {
        "name": "The Ink-Leads Rule",
        "body": "The move-forward action in any area is a near-black ink button; violet buttons are reserved for AI work.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every price, duration, timestamp and count uses tabular numerals so values align and don't jitter while playing.",
        "section": "typography"
      },
      {
        "name": "The Sentence-Case Rule",
        "body": "No uppercase, no letter-spaced labels. Group labels are small muted sentence-case text.",
        "section": "typography"
      },
      {
        "name": "The Floating-Only Rule",
        "body": "Cards, buttons, fields and choice cards never carry a shadow. If it does not float over the page, it does not cast one; the segmented-control thumb is the single in-surface exception.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do build every view from Cool Paper ground, White Surface cards with a 1px Hairline, and 12px corners.",
      "Do give each decision point one ink primary button; use the violet button only for AI work.",
      "Do show selection with violet border + Violet Wash + violet check, never by color alone.",
      "Do pair every state hue with its soft tint and a text label or icon.",
      "Do set prices, durations, timestamps and counts in tabular numerals.",
      "Do keep the 2px violet focus outline (2px offset) on every interactive element, and the 3px halo on fields.",
      "Do define any new color in both `:root` and `.dark` under the same token name.",
      "Do honor reduced motion; entrances stay under 300ms with the `cubic-bezier(0.16, 1, 0.3, 1)` ease-out."
    ],
    "donts": [
      "Don't introduce a second accent hue or color-code products, templates or categories.",
      "Don't put shadows on cards, buttons, fields or choice cards; shadows belong to toasts and dialogs.",
      "Don't use uppercase, letter-spaced eyebrow or kicker labels above headings.",
      "Don't place a second forward action beside the ink button; pair it with a secondary or ghost button.",
      "Don't use green, amber or red for anything but state.",
      "Don't hardcode raw hex in components; reference the semantic tokens."
    ]
  }
