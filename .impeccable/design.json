  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink button for the forward action at each decision point.",
      "html": "<button class=\"ds-btn-primary\">Escolher a voz <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:10px;background:var(--ink,#0d0f14);color:var(--on-ink,#fff);font:600 0.9375rem/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-btn-primary:hover{background:var(--ink-hover,#262a33)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#6d28d9);outline-offset:2px}.ds-btn-primary:disabled{opacity:.5;cursor:not-allowed}"
    },
    {
      "name": "AI Accent Button",
      "kind": "button",
      "refersTo": "button-accent",
      "description": "Violet button reserved for AI actions (write script, apply instruction).",
      "html": "<button class=\"ds-btn-accent\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72\"/><path d=\"m14 7 3 3\"/></svg>Escrever roteiro com IA</button>",
      "css": ".ds-btn-accent{display:inline-flex;align-items:center;gap:8px;height:48px;padding:0 20px;border:0;border-radius:12px;background:var(--accent,#6d28d9);color:#fff;font:600 1rem/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-btn-accent:hover{background:var(--accent-hover,#5b21b6)}.ds-btn-accent:focus-visible{outline:2px solid var(--accent,#6d28d9);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered white button for the alternative path.",
      "html": "<button class=\"ds-btn-secondary\">Já tenho o texto</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:1px solid var(--line-strong,#cdd1d9);border-radius:10px;background:var(--surface,#fff);color:var(--fg,#0d0f14);font:600 0.9375rem/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms}.ds-btn-secondary:hover{background:var(--sunken,#f1f2f5)}.ds-btn-secondary:focus-visible{outline:2px solid var(--accent,#6d28d9);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet muted action (back, more data, sample).",
      "html": "<button class=\"ds-btn-ghost\">Voltar às ofertas</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:var(--muted,#565c6b);font:600 0.875rem/1 Geist,ui-sans-serif,system-ui,sans-serif;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-btn-ghost:hover{background:var(--sunken,#f1f2f5);color:var(--fg,#0d0f14)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent,#6d28d9);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Text input with firm hairline and violet focus halo.",
      "html": "<label class=\"ds-label\" for=\"ds-f\">Nome do mercado ou açougue</label><input id=\"ds-f\" class=\"ds-field\" placeholder=\"Ex.: Supermercado Família\">",
      "css": ".ds-label{display:block;margin-bottom:6px;font:500 0.875rem/1.43 Geist,ui-sans-serif,system-ui,sans-serif;color:var(--fg,#0d0f14)}.ds-field{width:100%;background:var(--surface,#fff);border:1px solid var(--line-strong,#cdd1d9);border-radius:10px;padding:10px 14px;font:400 0.9375rem/1.4 Geist,ui-sans-serif,system-ui,sans-serif;color:var(--fg,#0d0f14);caret-color:var(--accent,#6d28d9);transition:border-color 120ms,box-shadow 120ms}.ds-field::placeholder{color:var(--muted,#565c6b);opacity:.85}.ds-field:hover{border-color:color-mix(in oklab,var(--line-strong,#cdd1d9) 60%,var(--fg,#0d0f14))}.ds-field:focus{outline:none;border-color:var(--accent,#6d28d9);box-shadow:0 0 0 3px color-mix(in oklab,var(--accent,#6d28d9) 22%,transparent)}"
    },
    {
      "name": "Choice Card",
      "kind": "custom",
      "refersTo": "choice-card-selected",
      "description": "Radio tile for tone, voice and chime; selected gets violet border, wash and check.",
      "html": "<div class=\"ds-choices\"><label class=\"ds-choice is-on\"><span class=\"ds-choice-name\">Varejão animado</span><span class=\"ds-choice-hint\">Rápido, alto e empolgado</span><svg class=\"ds-choice-check\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 6 9 17l-5-5\"/></svg></label><label class=\"ds-choice\"><span class=\"ds-choice-name\">Açougue e churrasco</span><span class=\"ds-choice-hint\">Apetitoso, valoriza os cortes</span></label></div>",
      "css": ".ds-choices{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-choice{position:relative;display:flex;flex-direction:column;gap:2px;padding:12px 14px;border:1px solid var(--line,#e4e6eb);border-radius:10px;background:var(--surface,#fff);cursor:pointer;transition:border-color 150ms,background-color 150ms}.ds-choice:hover{border-color:var(--line-strong,#cdd1d9)}.ds-choice.is-on{border-color:var(--accent,#6d28d9);background:var(--accent-soft,#f2edfd)}.ds-choice-name{font-size:.9375rem;font-weight:500;color:var(--fg,#0d0f14)}.ds-choice.is-on .ds-choice-name{color:var(--accent-fg,#5b21b6)}.ds-choice-hint{font-size:.875rem;color:var(--muted,#565c6b)}.ds-choice-check{position:absolute;top:12px;right:12px;color:var(--accent,#6d28d9)}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-option-selected",
      "description": "Sunken track with a lifted white thumb for the selected option.",
      "html": "<div class=\"ds-seg\"><span class=\"ds-seg-opt\">Curta <em>15s</em></span><span class=\"ds-seg-opt is-on\">Média <em>30s</em></span><span class=\"ds-seg-opt\">Longa <em>60s</em></span></div>",
      "css": ".ds-seg{display:inline-grid;grid-template-columns:repeat(3,auto);padding:4px;border-radius:10px;background:var(--sunken,#f1f2f5);border:1px solid var(--line,#e4e6eb);font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-seg-opt{display:flex;align-items:center;gap:6px;height:36px;padding:0 16px;border-radius:8px;font-size:.875rem;font-weight:500;color:var(--muted,#565c6b);cursor:pointer}.ds-seg-opt:hover{color:var(--fg,#0d0f14)}.ds-seg-opt em{font-style:normal;font-weight:400;color:var(--muted,#565c6b);font-variant-numeric:tabular-nums}.ds-seg-opt.is-on{background:var(--surface,#fff);color:var(--fg,#0d0f14);box-shadow:0 1px 3px rgb(0 0 0 / .1),0 1px 2px -1px rgb(0 0 0 / .1)}"
    },
    {
      "name": "Sidebar Step Nav",
      "kind": "nav",
      "refersTo": "nav-step-active",
      "description": "Numbered 1-2-3 steps: active violet, done green check, pending sunken.",
      "html": "<ol class=\"ds-steps\"><li class=\"ds-step is-on\"><span class=\"ds-dot\">1</span><span><b>Ofertas</b><small>Loja e produtos</small></span></li><li class=\"ds-step is-done\"><span class=\"ds-dot\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\"><path d=\"M20 6 9 17l-5-5\"/></svg></span><span><b>Roteiro</b><small>Texto do locutor</small></span></li><li class=\"ds-step\"><span class=\"ds-dot\">3</span><span><b>Voz e MP3</b><small>Ouvir e baixar</small></span></li></ol>",
      "css": ".ds-steps{list-style:none;margin:0;padding:0;width:232px;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-step{display:flex;align-items:center;gap:12px;padding:8px 12px;border-radius:8px;cursor:pointer;transition:background-color 150ms}.ds-step:hover{background:var(--sunken,#f1f2f5)}.ds-step.is-on{background:var(--accent-soft,#f2edfd)}.ds-dot{display:grid;place-items:center;width:24px;height:24px;border-radius:9999px;font-size:.75rem;font-weight:600;background:var(--sunken,#f1f2f5);color:var(--muted,#565c6b);border:1px solid var(--line,#e4e6eb)}.ds-step.is-on .ds-dot{background:var(--accent,#6d28d9);color:#fff;border-color:transparent}.ds-step.is-done .ds-dot{background:var(--success-soft,#e8f6ed);color:var(--success,#157f3c);border-color:transparent}.ds-step b{display:block;font-size:.9375rem;font-weight:500;color:var(--fg,#0d0f14)}.ds-step.is-on b{color:var(--accent-fg,#5b21b6)}.ds-step small{display:block;font-size:.75rem;color:var(--muted,#565c6b)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "White section card with hairline border and title row.",
